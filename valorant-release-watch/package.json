{
  "name": "valorant-release-watch",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Cloud-hosted VALORANT PC release monitoring with Discord alerts.",
  "engines": { "node": ">=22.14.0" },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "probe": "node scripts/probe.mjs",
    "test": "node --test test/*.test.mjs",
    "test:runtime": "npm run build && node scripts/runtime-smoke.mjs",
    "build": "wrangler deploy --dry-run --outdir dist --config wrangler.example.json",
    "dev": "wrangler dev --config wrangler.example.json",
    "status": "node scripts/admin.mjs status",
    "check": "node scripts/admin.mjs check",
    "test-alert": "node scripts/admin.mjs test-alert"
  },
  "devDependencies": { "wrangler": "4.156.0", "miniflare": "5.20261023.3-beta" }
}
